{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "flutter: analyze",
      "type": "shell",
      "command": "flutter",
      "args": ["analyze"],
      "problemMatcher": ["$dart-analyzer"],
      "group": {
        "kind": "build",
        "isDefault": false
      }
    },
    {
      "label": "flutter: test",
      "type": "shell",
      "command": "flutter",
      "args": ["test"],
      "group": {
        "kind": "test",
        "isDefault": true
      }
    },
    {
      "label": "flutter: test (with coverage)",
      "type": "shell",
      "command": "flutter",
      "args": ["test", "--coverage"],
      "group": {
        "kind": "test",
        "isDefault": false
      }
    },
    {
      "label": "flutter: pub get",
      "type": "shell",
      "command": "flutter",
      "args": ["pub", "get"],
      "problemMatcher": []
    },
    {
      "label": "flutter: clean",
      "type": "shell",
      "command": "flutter",
      "args": ["clean"],
      "problemMatcher": []
    },
    {
      "label": "flutter: clean & pub get",
      "type": "shell",
      "command": "flutter clean && flutter pub get",
      "problemMatcher": []
    }
  ]
}
